{
  "author": "Jason Williscroft",
  "auto-changelog": {
    "commitLimit": false,
    "hideCredit": true,
    "output": "CHANGELOG.md",
    "unreleased": true
  },
  "bugs": {
    "url": "https://github.com/karmaniverous/entity-client-dynamodb/issues"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1170.0",
    "@aws-sdk/lib-dynamodb": "^3.1170.0",
    "@commander-js/extra-typings": "^15.1.0",
    "@karmaniverous/aws-xray-tools": "^0.2.2",
    "@karmaniverous/batch-process": "^0.1.1",
    "@karmaniverous/entity-manager": "^8.0.1",
    "@karmaniverous/entity-tools": "^0.8.1",
    "aws-xray-sdk": "^3.12.0",
    "microdiff": "^1.6.0",
    "nanoid": "^6.0.2",
    "radash": "^12.1.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "description": "Entity Manager integrated into a DynamoDB client wrapper.",
  "devDependencies": {
    "@dotenvx/dotenvx": "^2.38.2",
    "@eslint/js": "^10.0.1",
    "@karmaniverous/dynamodb-local": "^0.0.1",
    "@karmaniverous/get-dotenv": "^8.0.0",
    "@rollup/plugin-alias": "^6.0.1",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-strip": "^3.0.4",
    "@rollup/plugin-typescript": "^12.3.1",
    "@smithy/types": "^4.20.0",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.0",
    "@vitest/eslint-plugin": "^1.6.28",
    "auto-changelog": "^2.7.0",
    "commander": "^15.1.0",
    "cross-env": "^10.1.0",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-tsdoc": "^0.5.4",
    "knip": "^6.45.1",
    "lefthook": "^2.2.2",
    "prettier": "^3.10.1",
    "release-it": "^21.1.2",
    "rimraf": "^6.1.4",
    "rollup": "^4.68.5",
    "rollup-plugin-dts": "^6.5.1",
    "tsd": "^0.33.0",
    "tslib": "^2.9.1",
    "tsx": "^4.23.15",
    "typedoc": "^0.28.20",
    "typedoc-plugin-mdn-links": "^5.1.1",
    "typedoc-plugin-replace-text": "^4.2.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.0"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/mjs/index.js"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./get-dotenv": {
      "import": {
        "types": "./dist/get-dotenv/index.d.ts",
        "default": "./dist/mjs/get-dotenv/index.js"
      },
      "require": {
        "types": "./dist/get-dotenv/index.d.ts",
        "default": "./dist/cjs/get-dotenv/index.js"
      }
    }
  },
  "files": [
    "dist"
  ],
  "peerDependenciesMeta": {
    "@karmaniverous/get-dotenv": {
      "optional": true
    }
  },
  "homepage": "https://github.com/karmaniverous/entity-client-dynamodb#readme",
  "keywords": [
    "dynamodb"
  ],
  "license": "BSD-3-Clause",
  "main": "dist/cjs/index.js",
  "module": "dist/mjs/index.js",
  "name": "@karmaniverous/entity-client-dynamodb",
  "publishConfig": {
    "access": "public"
  },
  "release-it": {
    "git": {
      "changelog": "npx auto-changelog --stdout --unreleased --template https://raw.githubusercontent.com/release-it/release-it/main/templates/changelog-compact.hbs",
      "commitMessage": "chore: release v${version}",
      "requireBranch": "main"
    },
    "github": {
      "release": true,
      "releaseName": "${name.split('/').pop()}@${version}",
      "releaseNotes": "npx auto-changelog --stdout --unreleased --template https://raw.githubusercontent.com/release-it/release-it/main/templates/changelog-compact.hbs"
    },
    "hooks": {
      "after:init": [
        "npm run lint",
        "npm run typecheck",
        "npm run test -- --coverage",
        "npm run build",
        "npm run knip",
        "npm run docs",
        "npm run verify:bundle",
        "npm run verify:package",
        "npm run verify:types",
        "npm run verify:smoke",
        "npm run pack:dry"
      ],
      "after:release": [
        "git switch -c release/${version}",
        "git push -u origin release/${version}",
        "git switch ${branchName}"
      ],
      "after:bump": [
        "npx auto-changelog -p",
        "npm run docs",
        "git add CHANGELOG.md"
      ]
    },
    "npm": {
      "publish": true
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/karmaniverous/entity-client-dynamodb.git"
  },
  "scripts": {
    "build": "rimraf dist && rollup --config rollup.config.ts --configLoader native",
    "changelog": "auto-changelog",
    "docs": "typedoc",
    "knip": "knip",
    "lint": "eslint .",
    "lint:fix": "npm run lint -- --fix .",
    "pack:dry": "npm pack --dry-run",
    "release": "dotenvx run -f .env.local -- release-it",
    "release:pre": "npm run release -- --no-git.requireBranch --github.prerelease --preRelease",
    "release:pre-minor": "npm run release minor -- --no-git.requireBranch --github.prerelease --preRelease=alpha",
    "release:pre-patch": "npm run release patch -- --no-git.requireBranch --github.prerelease --preRelease=alpha",
    "release:print-next-version": "release-it --release-version --no-git.requireBranch --no-git.requireUpstream --no-git.requireCleanWorkingDir --no-hooks",
    "test": "vitest --run --silent=true",
    "typecheck": "tsc && tsd",
    "verify:bundle": "tsx tools/verify-bundle.ts",
    "verify:package": "tsx tools/verify-packed-package.ts runtime",
    "verify:smoke": "node --input-type=module --eval \"await import('./dist/mjs/index.js'); await import('./dist/mjs/get-dotenv/index.js');\"",
    "verify:types": "tsx tools/verify-packed-package.ts types"
  },
  "type": "module",
  "types": "dist/index.d.ts",
  "version": "0.12.0-alpha.0",
  "peerDependencies": {
    "@karmaniverous/get-dotenv": "^8.0.0"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "allowScripts": {
    "protobufjs": true,
    "esbuild": true,
    "lefthook": true,
    "ssh2": true
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
